# Produção — copie para o Coolify (secrets reais, nunca commitar valores).
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=warn

# PostgreSQL (serviço gerenciado ou container com volume persistente)
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/atende_facil

# Valkey / Redis
REDIS_URL=redis://valkey:6379

# Multi-tenant
MULTI_TENANT=true
DEFAULT_TENANT_ID=

# Auth (gere secret forte: openssl rand -base64 48)
AUTH_SECRET=change-me-production-secret
AUTH_TOKEN_TTL_SECONDS=3600

# CORS — origem do painel web (se API e web em domínios diferentes)
# Com nginx proxy /api no mesmo domínio, pode ficar vazio.
CORS_ORIGINS=https://app.seudominio.com

# WhatsApp — nunca true em produção
DEV_MOCK_WHATSAPP_SEND=false

# Evolution (URL pública do serviço Evolution na VPS)
EVOLUTION_API_URL=https://evo.seudominio.com
EVOLUTION_API_KEY=

# Chatwoot — API interna ou pública
CHATWOOT_API_URL=https://chat.seudominio.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_APP_URL=https://chat.seudominio.com
CHATWOOT_SSO_SECRET=

# Chatwoot stack (compose)
CHATWOOT_SECRET_KEY_BASE=change-me-64-chars-minimum-for-rails-secret-key-base-xxxx
CHATWOOT_APP_URL=https://chat.seudominio.com

# Web container — upstream da API no compose
API_UPSTREAM=http://api:3000

# IA (futuro)
OPENAI_API_KEY=
