# Ambiente
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=debug

# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spec_driven

# Cache / fila
REDIS_URL=redis://localhost:6379
VALKEY_HOST_PORT=6379
POSTGRES_HOST_PORT=5432

# Multi-tenant
MULTI_TENANT=true
DEFAULT_TENANT_ID=

# Auth
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# Integrações WhatsApp
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Chatwoot (config global — débito técnico para migrar para config por tenant)
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_APP_URL=
CHATWOOT_SSO_SECRET=

# IA (futuro)
OPENAI_API_KEY=
