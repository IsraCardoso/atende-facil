# Ambiente
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=debug

# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spec_driven

# Cache / fila
REDIS_URL=redis://localhost:6379
VALKEY_HOST_PORT=6379
POSTGRES_HOST_PORT=5432

# Multi-tenant
MULTI_TENANT=true
DEFAULT_TENANT_ID=

# Auth
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# CORS (produção: https://app.seudominio.com — vazio em dev com proxy Vite)
CORS_ORIGINS=

# WhatsApp mock (somente development; proibido em production)
DEV_MOCK_WHATSAPP_SEND=false

# Integrações WhatsApp (Evolution gerenciada pela plataforma — RN-029)
# EVOLUTION_API_KEY deve coincidir com AUTHENTICATION_API_KEY no infra/docker-compose.yml
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=atende-facil-evo-key
# Webhook: em dev com Evolution no Docker use host.docker.internal; produção: https://api.seudominio.com
PUBLIC_API_URL=http://host.docker.internal:3000

# Chatwoot (config global — débito técnico para migrar para config por tenant)
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_APP_URL=
CHATWOOT_SSO_SECRET=

# IA (futuro)
OPENAI_API_KEY=
