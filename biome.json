{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "defaultStatus": "API legada de navegador. Evite status bar global e mantenha estado na aplicacao.",
              "status": "API legada de navegador. Evite status bar global e mantenha estado na aplicacao.",
              "scroll": "Use window.scroll(...) explicitamente para deixar o alvo da acao claro.",
              "outerHeight": "Use window.outerHeight explicitamente para evitar global implicito.",
              "screenX": "Use window.screenX explicitamente para evitar global implicito.",
              "opener": "Evite window.opener por riscos de seguranca e acoplamento entre janelas.",
              "onfocus": "Nao use handler global onfocus. Prefira window.addEventListener('focus', ...).",
              "pageYOffset": "Use window.scrollY explicitamente no lugar de pageYOffset.",
              "addEventListener": "Use window.addEventListener(...) explicitamente para evitar global implicito.",
              "defaultstatus": "API legada de navegador. Nao use defaultstatus global.",
              "history": "Use window.history explicitamente para navegacao.",
              "frames": "Evite acesso global a frames. Use window.frames explicitamente e valide origem.",
              "screenY": "Use window.screenY explicitamente para evitar global implicito.",
              "focus": "Use window.focus() explicitamente e apenas quando estritamente necessario.",
              "outerWidth": "Use window.outerWidth explicitamente para evitar global implicito.",
              "opera": "Propriedade nao padrao e obsoleta. Nao use deteccao via window.opera.",
              "external": "API legada de navegador. Evite window.external.",
              "innerHeight": "Use window.innerHeight explicitamente para evitar global implicito.",
              "closed": "Use window.closed explicitamente para evitar global implicito.",
              "isFinite": "Use Number.isFinite(value) para evitar coercoes implicitas do global isFinite.",
              "frameElement": "Use window.frameElement explicitamente e trate cenarios cross-origin.",
              "scrollY": "Use window.scrollY explicitamente para evitar global implicito.",
              "self": "Evite self implicito. Prefira globalThis ou window.self explicitamente.",
              "onblur": "Nao use handler global onblur. Prefira window.addEventListener('blur', ...).",
              "find": "window.find e nao padrao. Evite dependencia de API especifica de navegador.",
              "parent": "Use window.parent explicitamente e valide origem antes de acessar.",
              "top": "Use window.top explicitamente e valide origem para evitar erros de seguranca.",
              "moveBy": "Use window.moveBy(...) explicitamente; API pouco previsivel entre navegadores.",
              "menubar": "API de UI legada e pouco suportada. Evite window.menubar.",
              "length": "Global length e ambiguo (frames). Use referencia explicita ao objeto esperado.",
              "onerror": "Nao use handler global onerror. Prefira addEventListener('error', ...).",
              "onresize": "Nao use handler global onresize. Prefira addEventListener('resize', ...).",
              "removeEventListener": "Use window.removeEventListener(...) explicitamente.",
              "onload": "Nao use handler global onload. Prefira addEventListener('load', ...).",
              "scrollTo": "Use window.scrollTo(...) explicitamente para evitar global implicito.",
              "moveTo": "Use window.moveTo(...) explicitamente; API pouco previsivel entre navegadores.",
              "scrollX": "Use window.scrollX explicitamente para evitar global implicito.",
              "name": "Evite window.name por comportamento global persistente entre navegacoes.",
              "toolbar": "API de UI legada e pouco suportada. Evite window.toolbar.",
              "innerWidth": "Use window.innerWidth explicitamente para evitar global implicito.",
              "location": "Use window.location explicitamente para evitar sombra de identificador.",
              "locationbar": "API de UI legada e pouco suportada. Evite window.locationbar.",
              "scrollBy": "Use window.scrollBy(...) explicitamente para evitar global implicito.",
              "resizeTo": "Use window.resizeTo(...) explicitamente; API pouco previsivel entre navegadores.",
              "stop": "Evite global stop(). Se necessario, use window.stop() de forma explicita.",
              "scrollbars": "API de UI legada e pouco suportada. Evite window.scrollbars.",
              "blur": "Use window.blur() explicitamente e apenas quando estritamente necessario.",
              "screenTop": "Use window.screenTop explicitamente para evitar global implicito.",
              "confirm": "Evite confirm() global em fluxos criticos. Use componente/modal controlado.",
              "screen": "Use window.screen explicitamente para evitar global implicito.",
              "screenLeft": "Use window.screenLeft explicitamente para evitar global implicito.",
              "event": "Nao use global event implicito. Receba o evento como parametro da funcao.",
              "onunload": "Nao use handler global onunload. Prefira pagehide/beforeunload com cautela.",
              "pageXOffset": "Use window.scrollX explicitamente no lugar de pageXOffset.",
              "resizeBy": "Use window.resizeBy(...) explicitamente; API pouco previsivel entre navegadores.",
              "statusbar": "API de UI legada e pouco suportada. Evite window.statusbar.",
              "isNaN": "Use Number.isNaN(value) para evitar coercoes implicitas do global isNaN.",
              "close": "Use window.close() explicitamente e somente em janelas abertas pelo script.",
              "open": "Use window.open(...) explicitamente com noopener/noreferrer quando aplicavel.",
              "print": "Use window.print() explicitamente para deixar efeito colateral evidente."
            }
          }
        }
      }
    }
