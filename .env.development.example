NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spec_driven_dev
REDIS_URL=redis://localhost:6379
VALKEY_HOST_PORT=6379
POSTGRES_HOST_PORT=5432
MULTI_TENANT=true
DEFAULT_TENANT_ID=
AUTH_SECRET=development-change-me
AUTH_TOKEN_TTL_SECONDS=3600
# false = WhatsApp real via Evolution (teste local completo no celular)
# true = simula envio sem Evolution (somente inbox/API)
DEV_MOCK_WHATSAPP_SEND=false

# Evolution API (gerenciada pela plataforma — mesmo valor do infra/docker-compose.yml)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=atende-facil-evo-key
# URL que o container Evolution usa para chamar webhooks da API (host.docker.internal no Docker Desktop)
PUBLIC_API_URL=http://host.docker.internal:3000

# Chatwoot (opcional — necessário apenas para chat humano embutido no painel)
# CHATWOOT_API_URL = URL da API REST do Chatwoot (não confundir com a API Atende Fácil :3000)
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_TOKEN=
# URL pública do painel Chatwoot (ex.: http://localhost:3001 se rodar Chatwoot em outra porta)
CHATWOOT_APP_URL=
# CHATWOOT_PLATFORM_TOKEN = Platform App token. Habilita o login unico (SSO): o atendente
# loga so no Atende Facil e o Chatwoot embutido abre autenticado. Sem ele, o painel cai no
# deep link e o atendente precisa logar no Chatwoot manualmente.
# Gerar no console Rails do Chatwoot:
#   PlatformApp.create(name: 'atende-facil').access_token.token
CHATWOOT_PLATFORM_TOKEN=
