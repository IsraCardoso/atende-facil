{
  "name": "atende-facil",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run build",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "valkey:check": "bun run --cwd packages/db valkey:check",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "verify:evolution": "powershell -ExecutionPolicy Bypass -File scripts/local/verify-evolution.ps1",
    "ai:sync": "bun run scripts/sync-ai-rules.ts",
    "openspec": "node scripts/openspec-run.mjs",
    "openspec:list": "node scripts/openspec-run.mjs list",
    "openspec:specs": "node scripts/openspec-run.mjs spec list",
    "openspec:validate": "node scripts/openspec-run.mjs validate --specs",
    "openspec:view": "node scripts/openspec-run.mjs view",
    "openspec:migrate": "node scripts/migrate-to-openspec.mjs",
    "openspec:update": "node scripts/openspec-run.mjs update",
    "openspec:reinstall": "node scripts/openspec-run.mjs update --force && bun run ai:sync",
    "openspec:ui": "powershell -ExecutionPolicy Bypass -File scripts/start-openspec-ui.ps1",
    "openspec:ui:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-openspec-ui.ps1"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@fission-ai/openspec": "1.4.1",
    "turbo": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
