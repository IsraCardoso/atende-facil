{
  "name": "db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "lint": "biome check .",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../../.env.development.example src/scripts/migrate.ts",
    "valkey:check": "bun --env-file=../../.env.development.example src/scripts/validate-valkey.ts"
  },
  "dependencies": {
    "drizzle-orm": "latest",
    "postgres": "latest",
    "redis": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "latest"
  }
}
